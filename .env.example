# Local development settings. Copy to .env (never committed) and adjust. Production values come from the
# deployment's environment or secret manager; see docs/OPERATIONS.md.
DOCINTEL_ENVIRONMENT=development
DOCINTEL_DATABASE_URL=postgresql://docintel_app:CHANGE_ME@127.0.0.1:5432/docintel
DOCINTEL_VECTOR_BACKEND=milvus
DOCINTEL_MILVUS_URI=http://127.0.0.1:19530
DOCINTEL_EMBEDDER_URL=http://127.0.0.1:8080
DOCINTEL_EMBEDDING_MODEL=all-mpnet-base-v2
DOCINTEL_TASK_MODE=thread
# DOCINTEL_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0      # required with DOCINTEL_TASK_MODE=celery
DOCINTEL_STORAGE_DIR=./data/objects
DOCINTEL_API_KEYS_FILE=./api_keys.json
DOCINTEL_LOG_JSON=false
# Semantic search can be switched off entirely; exact, lexical and structured search keep working:
# DOCINTEL_VECTOR_BACKEND=disabled
# Grounded answers (query option "answer": true). "extractive" quotes evidence and needs no model.
# DOCINTEL_ANSWER_PROVIDER=anthropic          # needs: pip install .[answer]
# DOCINTEL_ANSWER_MODEL=claude-opus-5-5
# DOCINTEL_ANSWER_API_KEY=                    # or leave unset to use ANTHROPIC_API_KEY / an `ant auth login` profile
# DOCINTEL_ANSWER_EFFORT=medium
