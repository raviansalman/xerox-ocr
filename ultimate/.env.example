# xerox-ocr environment template.
# Copy to docker.staging.env (the default compose env_file) or set ULTIMATE_ENV_FILE to point at your copy.
# Never commit a filled-in copy of this file.

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Milvus
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=ultimate_document_chunks
MILVUS_VECTOR_SIZE=768
MILVUS_DISTANCE_METRIC=COSINE
# BOTH mode: cap semantic thread wait (aligned with staging search-separation)
SEMANTIC_MAX_SECONDS_BOTH=8.0
# Skip full Milvus metadata-index scan unless this many seconds remain
METADATA_INDEX_MIN_BUDGET_SEC=20
SEMANTIC_TIMEOUT_RATIO=0.85
# Search timeouts: configurable via env (reduced from 90/100 to avoid long waits; 45/60 allows metadata-first to complete)
SEMANTIC_MAX_SECONDS_METADATA_FIRST=45
SEARCH_REQUEST_CAP_METADATA_FIRST=60
# BYOC production: 100% search success + efficient speed under load
SEARCH_REQUEST_CAP_SEC=45
# BOTH mode: reserved for future use (validator empty-set recall); staging sets for documentation parity
BOTH_FALLBACK_ON_EMPTY_VALIDATION=1
SEARCH_REQUEST_TIMEOUT=120
SEARCH_MAX_CONCURRENT=30
# Milvus HNSW ef: 48=faster search, 64=default recall (lower ef = faster, slight recall trade-off)
MILVUS_SEARCH_EF=48
# Increased gRPC timeout to handle concurrent insert pressure (was 8s → 30s)
MILVUS_GRPC_TIMEOUT_MS=30000
MILVUS_CONNECT_TIMEOUT=30
# NOTE for host-side tests: set MILVUS_HOST=127.0.0.1 (not 'localhost') to
# avoid gRPC connecting to the IPv6 loopback ::1 which causes UNAVAILABLE errors.

# Embedding Model (MPNet)
EMBED_MODEL_TEXT=sentence-transformers/all-mpnet-base-v2
EMBED_MODEL_DIM=768
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_BATCH_SIZE=64
EMBEDDING_USE_ONNX=false

EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBED_MODEL_TEXT=sentence-transformers/all-mpnet-base-v2
MILVUS_VECTOR_SIZE=768
EMBED_MODEL_DIM=768

# Disable PyTorch / tokenizers parallelization to prevent thread spawning
# and CPU starvation which leads to Milvus disconnections and hanging workers
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
NUMEXPR_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
MALLOC_ARENA_MAX=2

# CSV / Spreadsheet caps for fast, safe extraction + embedding
# Reduced from 2M to 500K to prevent OOM crashes in spreadsheet-large worker
# (3.9MB CSVs like personal_raw_loantape.csv were exhausting 10GB mem limit)
CSV_EMBED_CHAR_LIMIT=500000
CSV_EMBED_ROW_LIMIT=50000
CSV_EXTRACT_CHAR_LIMIT=500000
CSV_EXTRACT_ROW_LIMIT=50000
SPREADSHEET_EMBED_CHAR_LIMIT=500000
SPREADSHEET_EMBED_LINE_LIMIT=50000
SPREADSHEET_SKIP_METADATA=true
SPREADSHEET_MAX_CHUNK_SIZE=12000
SPREADSHEET_TARGET_MAX_CHUNKS=50

# CSV sharding for parallel large-file processing
CSV_SHARD_ENABLED=true
CSV_SHARD_MIN_BYTES=5000000
CSV_SHARD_MIN_ROWS=200000
CSV_SHARD_MIN_CHARS=2000000
CSV_SHARD_SAMPLE_ROWS=2000
CSV_SHARD_ROWS=5000
CSV_SHARD_CHAR_LIMIT=1000000
CSV_MAX_SHARDS=200
CSV_HAS_HEADER=true
CSV_CHUNK_SIZE=12000
CSV_TARGET_MAX_CHUNKS=50
CSV_SHARD_WATCHDOG_INTERVAL=120
CSV_SHARD_STALE_SECONDS=900

# Routing: keep small spreadsheets on normal worker (< 5MB)
SMALL_SPREADSHEET_BYTES=5242880

# Worker concurrency (all workers use --concurrency=1 with --pool=solo)
CELERY_CONCURRENCY=1
CELERY_LARGE_CONCURRENCY=1

# Scalability and Reliability
# MILVUS_CIRCUIT_COOLDOWN_SEC: 0=disabled, 5=fast recovery (load test), 20=default
MILVUS_CIRCUIT_COOLDOWN_SEC=5
STUCK_JOB_THRESHOLD=600
HEARTBEAT_INTERVAL=60
MAX_TASK_RETRIES=15
RETRY_DELAY_BASE=10
SKIP_IMAGE_CAPTIONING_IN_PROCESSOR=true
EMBEDDER_URL=http://ultimate-embedder:8080/embed
# Embedder client: retries and timeout for load stability (workers retry on RemoteDisconnected)
EMBEDDER_MAX_RETRIES=5
EMBEDDER_TIMEOUT=180
# Smaller batches = more parallelism, less blocking (64 caused 2+ min per request)
EMBEDDING_BATCH_SIZE=24
# Queue routing: 0=base queues (ultimate_pdf, ultimate_ocr, etc.) - MUST match workers.
# Workers consume base queues; QUEUE_SHARD_COUNT=8 would send to ultimate_*_u0..u7 (no workers).
QUEUE_SHARD_COUNT=0

# Search recall: 0.05 for 100% hit ratio. Lexical boost ranks strongest first.
SEARCH_MIN_SCORE=0.05

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100
CHUNK_MODEL=gpt-3.5-turbo

# File Upload
MAX_FILE_SIZE=104857600
TEMP_UPLOAD_DIR=./temp_uploads

# Security
CORS_ORIGINS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Logging
LOG_FORMAT=json
LOG_FILE=./logs/api.log
LOG_ROTATION=daily
LOG_RETENTION=30

# Workflow (unchanged)
EXTERNAL_SERVICE_URL=https://your-external-service.example.com
EXTERNAL_ACCESS_KEY=
EXTERNAL_STOR_API_KEY=
WORKFLOW_API_URL=https://your-workflow-api.example.com
WORKFLOW_ACCESS_KEY=
WORKFLOW_STOR_API_KEY=
WORKFLOW_ENABLED=false
WORKFLOW_TIMEOUT=10
WORKFLOW_RETRY_ATTEMPTS=3

# Pre-warm: load this user's metadata index on startup so the first query is
# served from the correct disk cache instead of triggering a slow Milvus rebuild.
PRIMARY_USER_ID=

# Metadata index Redis sync
# Set to true ONLY on the processing server (the authoritative publisher).
# The dedicated search server is a subscriber — it reads from Redis, never writes.
METADATA_INDEX_PUBLISHER=true
