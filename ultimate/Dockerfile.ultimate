# Ultimate Search Processor - Minimal Docker Image
FROM python:3.12-slim

WORKDIR /app

# Install minimal system dependencies for OCR
RUN apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 update && \
    apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 install -y --no-install-recommends --fix-missing \
    tesseract-ocr \
    tesseract-ocr-eng \
    antiword \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    # libxrender-dev pulls xtrans-dev which is failing from mirror; not required for headless OCR
    libgomp1 \
    libgthread-2.0-0 \
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    python3-dev \
    curl \
    wget \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY ultimate/requirements_ultimate.txt .

# Install optimized transformer stack first
# CRITICAL: Pin setuptools==68.0.0 to ensure pkg_resources is available for pymilvus
# (pymilvus 2.4.0 requires setuptools>=67, but newer versions removed pkg_resources)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir "setuptools==68.0.0" && \
    pip install --no-cache-dir tokenizers==0.15.2 && \
    pip install --no-cache-dir transformers==4.41.1 && \
    pip install --no-cache-dir sentence-transformers==2.7.0 && \
    pip install --no-cache-dir accelerate==0.30.1 && \
    pip install --no-cache-dir numpy && \
    pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir torchvision --index-url https://download.pytorch.org/whl/cpu

# Install remaining requirements
RUN pip install --no-cache-dir -r requirements_ultimate.txt

# Copy app source
COPY ultimate/src ./src
COPY ultimate/ultimate_ui.py ./

# Create necessary dirs
RUN mkdir -p temp_uploads logs cache

# Pre-download models at build time so containers never hit HuggingFace.
# If this fails, the image build should fail fast.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/all-mpnet-base-v2', cache_folder='/app/cache')"
RUN python -c "from transformers import AutoTokenizer, AutoModelForSequenceClassification; AutoTokenizer.from_pretrained('BAAI/bge-reranker-base', cache_dir='/app/cache'); AutoModelForSequenceClassification.from_pretrained('BAAI/bge-reranker-base', cache_dir='/app/cache')"

ENV PYTHONPATH=/app
ENV TESSERACT_CMD=/usr/bin/tesseract
ENV SENTENCE_TRANSFORMERS_HOME=/app/cache
# Run entirely from local cache at runtime – no external model downloads.
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

EXPOSE 8000

# Run uvicorn with multiple workers for better concurrency and isolation.
CMD ["uvicorn", "ultimate_ui:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--timeout-keep-alive", "120"]
