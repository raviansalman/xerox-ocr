# Copy to deploy/.env and fill in. Never commit the filled-in file.
POSTGRES_PASSWORD=
DOCINTEL_DB_PASSWORD=
DOCINTEL_REDIS_PASSWORD=
# Bearer token Prometheus sends to GET /metrics (required in production)
DOCINTEL_METRICS_TOKEN=
# JSON list of hashed API keys; create entries with: docintel keygen
DOCINTEL_API_KEYS_PATH=./api_keys.json
DOCINTEL_PORT=8000
DOCINTEL_API_WORKERS=2
DOCINTEL_WORKER_CONCURRENCY=4
DOCINTEL_EMBEDDING_MODEL=all-mpnet-base-v2
DOCINTEL_EMBEDDER_DEVICE=cpu
DOCINTEL_CORS_ORIGINS=
DOCINTEL_URL_FETCH_ENABLED=false
# Optional cross-encoder reranker (baked into the embedder image at build time; off when empty)
DOCINTEL_RERANKER_MODEL=
# Grounded answers ("answer": true on a query): extractive (no model), anthropic, or disabled
DOCINTEL_ANSWER_PROVIDER=extractive
DOCINTEL_ANSWER_API_KEY=
# Package index for the CPU build of torch in the embedder image; set empty to use PyPI
DOCINTEL_TORCH_INDEX=https://download.pytorch.org/whl/cpu
